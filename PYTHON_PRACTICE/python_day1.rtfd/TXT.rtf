6. Zigzag Conversion\
\
class Solution:\
    def convert(self, s: str, numRows: int) -> str:\
        if numRows==1. and numRows >= len(s):\
            return s\
\
        row = [""] * numRows\
        r = 0\
        d = 1\
        for ch in s:\
            row[r] += ch\
            if r==0:\
                d = 1\
            elif r == numRows -1:\
                d = -1\
            r+=d\
        return "".join(row)\
\
